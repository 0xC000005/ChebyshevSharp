<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>ChebyshevSharp</PackageId>
    <Version>0.13.2</Version>
    <PyChebyshevParity>0.21.1</PyChebyshevParity>
    <InformationalVersion>$(Version)+pychebyshev.$(PyChebyshevParity)</InformationalVersion>
    <Authors>Max</Authors>
    <Description>ChebyshevSharp $(Version) — multi-dimensional Chebyshev tensor interpolation for .NET with dense, spline, sliding, and Tensor Train approximations, analytical derivatives, serialization, stricter public validation, high-dimensional tensor-size guards, CI/package validation gates, runnable examples, and organized documentation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/0xC000005/ChebyshevSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0xC000005/ChebyshevSharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>chebyshev;interpolation;barycentric;numerical;tensor;derivatives</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.13.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/_/src/ChebyshevSharp</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChebyshevSharp.Tests" />
    <InternalsVisibleTo Include="ChebyshevSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlasSharp.OpenBlas" Version="0.3.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

</Project>
